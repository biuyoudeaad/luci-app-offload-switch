#!/usr/bin/ucode

'use strict';

import { readfile, stat } from 'fs';
import { cursor } from 'uci';

const CONFIG = 'offload';

/* ------------------------------------------------------------------ *
 * Small helpers
 * ------------------------------------------------------------------ */

function readtrim(path) {
	let s = readfile(path);
	return type(s) == 'string' ? replace(s, /^\s+|\s+$/g, '') : '';
}

function exists(path) {
	return !!stat(path);
}

function is_val(v) {
	return v === '1' || v === true || v === 1;
}

/* ------------------------------------------------------------------ *
 * Platform / engine detection
 * ------------------------------------------------------------------ */

function dist_info() {
	let rel = readfile('/etc/openwrt_release') || '';
	let info = {};

	for (let line in split(rel, '\n')) {
		let m = match(line, /^(DISTRIB_[A-Z_]+)='([^']*)'/);
		if (m)
			info[m[1]] = m[2];
	}

	return {
		release: info.DISTRIB_RELEASE || '',
		target: info.DISTRIB_TARGET || '',
		arch: info.DISTRIB_ARCH || '',
		description: info.DISTRIB_DESCRIPTION || '',
		model: readtrim('/tmp/sysinfo/model'),
		board: readtrim('/tmp/sysinfo/board_name')
	};
}

function has_firewall4() {
	return exists('/usr/share/ucode/fw4.uc') || exists('/sbin/fw4') || exists('/usr/sbin/fw4');
}

function firewall_state() {
	let u = cursor();
	u.load('firewall');

	let fullcone = false;
	let flow_offloading = false;
	let flow_offloading_hw = false;

	u.foreach('firewall', 'defaults', (s) => {
		if (is_val(s.fullcone)) fullcone = true;
		if (is_val(s.flow_offloading)) flow_offloading = true;
		if (is_val(s.flow_offloading_hw)) flow_offloading_hw = true;
	});

	u.foreach('firewall', 'zone', (s) => {
		if (is_val(s.fullcone)) fullcone = true;
	});

	return {
		fullcone: fullcone,
		flow_offloading: flow_offloading,
		flow_offloading_hw: flow_offloading_hw
	};
}

function nss_present() {
	return exists('/etc/init.d/qca-nss-ecm') ||
		exists('/sys/module/ecm') ||
		exists('/lib/netifd/offload/disable_offloads.sh');
}

/* Best-effort check for the SonIC FullCone build, which patches the firewall
 * zone view and force-writes flow_offloading=0 on every form save. */
function fullcone_build() {
	return exists('/www/luci-static/resources/view/firewall/zones-sonic.js') ||
		exists('/usr/share/luci/menu.d/luci-app-fullconenat-sonic.json') ||
		exists('/www/luci-static/resources/tools/fullconenat-sonic.js');
}

function nss_active() {
	return exists('/sys/module/ecm');
}

const ATH11K_MODFILE = '/etc/modules.d/ath11k';
const ATH11K_PARAM = '/sys/module/ath11k/parameters/nss_offload';

function ath11k_present() {
	return exists(ATH11K_MODFILE) || exists(ATH11K_PARAM);
}

function ath11k_runtime_offload() {
	/* Running value copied into the driver at init; -1 when unavailable. */
	let v = readtrim(ATH11K_PARAM);
	if (v == '1' || v == 'Y' || v == 'y')
		return 1;
	if (v == '0' || v == 'N' || v == 'n')
		return 0;
	return -1;
}

function ath11k_persisted_offload() {
	let f = readfile(ATH11K_MODFILE);
	if (type(f) != 'string')
		return -1;
	let m = match(f, /nss_offload=([0-9]+)/);
	return m ? (m[1] == '1' ? 1 : 0) : -1;
}

function bcm_steering_present() {
	return exists('/usr/libexec/platform/packet-steering.sh') ||
		exists('/usr/libexec/network/packet-steering.uc');
}

function detect_platform() {
	let d = dist_info();
	let target = d.target;
	let vendor, platform;

	if (nss_present()) {
		vendor = 'qualcomm';
		platform = 'Qualcomm NSS / ECM';
	}
	else if (match(target, /^mediatek\//)) {
		vendor = 'mediatek';
		platform = 'MediaTek PPE / WED';
	}
	else if (match(target, /^airoha/)) {
		vendor = 'airoha';
		platform = 'Airoha PPE';
	}
	else if (match(target, /^(bcm4908|bcm53xx|bcm47xx)/)) {
		vendor = 'broadcom';
		platform = 'Broadcom accelerator';
	}
	else {
		vendor = 'generic';
		platform = 'Software flowtable';
	}

	return { vendor: vendor, platform: platform, detect: d };
}

function engine_list(fwdef, plat) {
	let engines = [];

	if (has_firewall4()) {
		push(engines, {
			id: 'flowtable',
			label: 'Netfilter flowtable',
			present: true,
			active: fwdef.flow_offloading || fwdef.flow_offloading_hw,
			hardware: fwdef.flow_offloading_hw,
			controllable: true,
			locked: fwdef.fullcone,
			note: fwdef.fullcone
				? 'Locked while FullCone NAT is enabled: flowtable offload can make FullCone inbound mapping inconsistent.'
				: ''
		});
	}

	if (nss_present()) {
		push(engines, {
			id: 'nss-ecm',
			label: 'Qualcomm NSS ECM (hardware)',
			present: true,
			active: nss_active(),
			hardware: true,
			controllable: true,
			note: nss_active()
				? 'Running: accelerated forwarded flows bypass the CPU path, so conntrack-based accounting under-reports.'
				: 'Stopped.'
		});
	}

	if (ath11k_present()) {
		let rt = ath11k_runtime_offload();
		let ps = ath11k_persisted_offload();
		let active = (rt == 1);
		push(engines, {
			id: 'nss-wifi',
			label: 'Qualcomm Wi-Fi NSS offload (ath11k)',
			present: true,
			active: active,
			hardware: true,
			controllable: true,
			pending_reboot: (rt != -1 && ps != -1 && (rt == 1) != (ps == 1)),
			note: active
				? 'On: Wi-Fi client traffic can bypass the CPU path. Changing it needs a reboot.'
				: (rt == -1
					? 'Driver parameter is not readable yet.'
					: 'Off: Wi-Fi traffic stays on the CPU path.')
		});
	}

	if (plat.vendor == 'mediatek' || plat.vendor == 'airoha') {
		push(engines, {
			id: plat.vendor + '-ppe',
			label: plat.vendor == 'mediatek' ? 'MediaTek PPE / WED (hardware)' : 'Airoha PPE (hardware)',
			present: true,
			active: fwdef.flow_offloading_hw,
			hardware: true,
			controllable: false,
			note: 'Hardware offload rides on the flowtable hardware flag and follows its control above.'
		});
	}

	if (bcm_steering_present()) {
		push(engines, {
			id: 'packet-steering',
			label: 'Hardware packet steering',
			present: true,
			active: fwdef.flow_offloading || fwdef.flow_offloading_hw,
			hardware: true,
			controllable: false,
			note: 'Steering follows the flowtable flags; there is no separate service.'
		});
	}

	return engines;
}

function status_payload() {
	let plat = detect_platform();
	let fwdef = firewall_state();
	let u = cursor();
	u.load(CONFIG);

	let engines = engine_list(fwdef, plat);

	/* A pending reboot is present when any engine reports it. */
	let pending_reboot = false;
	for (let e in engines)
		if (e && e.pending_reboot === true)
			pending_reboot = true;

	return {
		platform: plat.platform,
		vendor: plat.vendor,
		detect: plat.detect,
		fullcone: fwdef.fullcone,
		fullcone_build: fullcone_build(),
		mode: u.get(CONFIG, 'config', 'mode') || 'accelerate',
		pending_reboot: pending_reboot,
		engines: engines
	};
}

/* ------------------------------------------------------------------ *
 * RPC methods
 *
 * The page only reads status here. Applying a change is an ordinary UCI
 * commit of `offload.config.mode`, which the ucitrack config trigger turns
 * into a reconciler run (/etc/init.d/offload-switch reload).
 * ------------------------------------------------------------------ */

const methods = {
	status: {
		args: {},
		call: function() {
			return status_payload();
		}
	}
};

return { 'luci.offload': methods };
