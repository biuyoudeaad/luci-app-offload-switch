msgid "Performance"
msgstr "性能"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:219
msgid "Performance mode"
msgstr "性能模式"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:156
msgid "Platform"
msgstr "平台"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:76
msgid "Read-only"
msgstr "只读"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:84
msgid "Reboot pending"
msgstr "待重启"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:82
msgid "Software"
msgstr "软件"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:148
#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:151
#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:239
msgid "Statistics"
msgstr "统计"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:211
msgid "Statistics mode"
msgstr "统计模式"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:126
msgid "Switch every traffic accelerator on or off in one place: choose accurate per-host statistics or maximum routing throughput. The platform and its accelerators are detected automatically."
msgstr "在一处统一切换所有流量加速引擎的开关：在精确的按主机统计与最高转发性能之间取舍。平台及其加速引擎会自动检测。"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:158
msgid "Target"
msgstr "目标平台"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:269
msgid "The Qualcomm NSS/ECM engine is started for hardware acceleration."
msgstr "Qualcomm NSS/ECM 引擎已启动以进行硬件加速。"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:243
msgid "The Qualcomm NSS/ECM engine is stopped; accelerated flows are flushed and the module unloaded."
msgstr "Qualcomm NSS/ECM 引擎已停止；加速流被清除且模块已卸载。"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:139
msgid "The Wi-Fi NSS offload setting changed but the running driver still uses the previous value. Reboot the device to apply it."
msgstr "Wi-Fi NSS 卸载设置已更改，但运行中的驱动仍在使用之前的值。请重启设备以使其生效。"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:257
msgid "The Wi-Fi NSS offload setting is only read when the driver starts, so it stays active until you reboot."
msgstr "Wi-Fi NSS 卸载设置仅在驱动启动时读取，因此在重启前它仍然生效。"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:290
msgid "The firewall page forces flowtable offload off whenever its form is saved, which will undo this setting. Re-apply this page afterwards if that happens."
msgstr "防火墙页面在任何一次表单保存时都会强制关闭 flowtable 卸载，这会撤销此处的设置。如发生这种情况，请在本页面重新应用。"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:131
msgid "The luci.offload status RPC failed. Check rpcd and the package installation."
msgstr "luci.offload 状态 RPC 失败。请检查 rpcd 与软件包安装。"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:277
msgid "This is the normal operating mode for everyday use."
msgstr "这是日常使用的常规运行模式。"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:274
msgid "Throughput rises and CPU load drops, but conntrack-based accounting (nlbwmon) may under-report."
msgstr "吞吐量提升、CPU 占用降低，但基于 conntrack 的统计（nlbwmon）可能少计。"

#: package/emortal/luci-app-offload-switch/root/usr/share/luci/menu.d/luci-app-offload-switch.json:3
msgid "Traffic Offload"
msgstr "流量卸载"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:124
msgid "Traffic Offload Switch"
msgstr "流量卸载开关"

