msgid "Unable to read accelerator status."
msgstr "无法读取加速引擎状态。"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:325
msgid "Unable to save changes: %s"
msgstr "无法保存更改：%s"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:156
msgid "Unknown"
msgstr "未知"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:251
msgid "Use this while you need trustworthy per-host numbers, then switch back. Expect lower peak throughput."
msgstr "需要可信的单主机数据时使用，用完再切回。峰值吞吐会降低。"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:239
#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:263
msgid "What will happen"
msgstr "将会发生什么"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:246
msgid "Wi-Fi NSS offload (ath11k) is turned off. A reboot is needed for this to take effect."
msgstr "关闭 Wi-Fi NSS 卸载（ath11k）。需要重启才能生效。"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:272
msgid "Wi-Fi NSS offload (ath11k) is turned on. A reboot is needed for this to take effect."
msgstr "开启 Wi-Fi NSS 卸载（ath11k）。需要重启才能生效。"

