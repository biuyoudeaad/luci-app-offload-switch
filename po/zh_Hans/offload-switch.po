#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:138
#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:256
msgid "A reboot is required."
msgstr "需要重启。"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:212
msgid "Acceleration off — keep traffic on the CPU."
msgstr "关闭加速——让流量走 CPU。"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:220
msgid "Acceleration on — fastest routing."
msgstr "开启加速——最快转发。"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:222
msgid "Accelerators enabled where safe"
msgstr "在安全前提下启用各加速引擎"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:71
msgid "Active"
msgstr "已启用"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:168
msgid "Active engines forward established traffic outside the normal CPU path. That is what makes the router fast, and also what makes per-host accounting under-report."
msgstr "已启用的加速引擎会绕过常规 CPU 路径转发已建立的流量。这既让路由器更快，也会导致按主机统计流量时少计。"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:323
msgid "Changes have been saved. Use \"Save & Apply\" to activate them."
msgstr "更改已保存。请使用“保存并应用”使其生效。"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:228
msgid "Choose a goal"
msgstr "选择目标"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:215
msgid "Conntrack / nlbwmon see forwarded flows again"
msgstr "conntrack / nlbwmon 重新能看到转发流量"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:224
msgid "Conntrack-based accounting may under-report"
msgstr "基于 conntrack 的统计可能少计"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:80
msgid "Controllable"
msgstr "可控"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:155
msgid "Current goal"
msgstr "当前目标"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:166
msgid "Detected acceleration engines"
msgstr "检测到的加速引擎"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:159
msgid "Disabled"
msgstr "已禁用"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:159
msgid "Enabled"
msgstr "已启用"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:170
msgid "Engine status is unavailable because the status RPC failed."
msgstr "状态 RPC 调用失败，无法获取加速引擎状态。"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:283
msgid "Flowtable offload can make inbound FullCone mapping inconsistent, so it stays disabled in this mode. Hardware acceleration (NSS/ECM) is unaffected. To also enable flowtable offload, disable FullCone NAT first."
msgstr "flowtable 卸载可能导致入站 FullCone 映射不一致，因此该模式下保持关闭。硬件加速（NSS/ECM）不受影响。如需同时启用 flowtable 卸载，请先关闭 FullCone NAT。"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:267
msgid "Flowtable offload is enabled (software + hardware)."
msgstr "flowtable 卸载已启用（软件 + 硬件）。"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:266
msgid "Flowtable offload is kept off because FullCone NAT is enabled (see note below)."
msgstr "由于已启用 FullCone NAT，flowtable 卸载保持关闭（见下方说明）。"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:214
msgid "Flowtable, NSS/ECM and Wi-Fi NSS offload turned off"
msgstr "关闭 flowtable、NSS/ECM 和 Wi-Fi NSS 卸载"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:248
msgid "Forwarded traffic returns to the CPU path, so conntrack / nlbwmon see it again."
msgstr "转发流量回到 CPU 路径，因此 conntrack / nlbwmon 又能统计到。"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:159
msgid "FullCone NAT"
msgstr "FullCone NAT"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:282
msgid "FullCone NAT is enabled."
msgstr "已启用 FullCone NAT。"

#: package/emortal/luci-app-offload-switch/root/usr/share/rpcd/acl.d/luci-app-offload-switch.json:3
msgid "Grant access to luci-app-offload-switch"
msgstr "授予对 luci-app-offload-switch 的访问权限"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:82
msgid "Hardware"
msgstr "硬件"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:78
msgid "Locked by FullCone"
msgstr "被 FullCone 锁定"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:216
msgid "Lower maximum throughput / higher CPU load"
msgstr "最高吞吐量较低 / CPU 负载较高"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:223
msgid "Maximum throughput, lowest CPU load"
msgstr "最高吞吐量，最低 CPU 负载"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:157
msgid "Model"
msgstr "型号"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:241
msgid "Netfilter flowtable offload is turned off (software and hardware)."
msgstr "netfilter flowtable 卸载已关闭（软件和硬件）。"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:173
msgid "No hardware accelerator was detected; only the software network path is used."
msgstr "未检测到硬件加速引擎；仅使用软件网络转发路径。"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:289
msgid "Note on the firewall page."
msgstr "关于防火墙页面的说明。"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:296
msgid "Note: accounting differs by tool. conntrack-based tools (nlbwmon) miss hardware-accelerated flows; eBPF/tc tools (bandix) count at the interface and may still see them."
msgstr "注意：不同统计工具行为不同。基于 conntrack 的工具（nlbwmon）会漏掉硬件加速的流量；eBPF/tc 类工具（bandix）在接口层统计，仍可能看到这些流量。"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:72
msgid "Off"
msgstr "已关闭"

#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:148
#: package/emortal/luci-app-offload-switch/htdocs/luci-static/resources/view/offload/overview.js:152
